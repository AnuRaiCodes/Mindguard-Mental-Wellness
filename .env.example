# MindGuard — Environment Variables
# Copy this file to .env and fill in your values

# ─── Flask ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///mindguard.db

# ─── Groq API ───────────────────────────────────────────────────────────────
# Get your free key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# ─── Demo / Mock Mode ───────────────────────────────────────────────────────
# Set to True to run without a real Groq API key (uses canned responses)
DEMO_MODE=False

# ─── RAG / Embeddings ───────────────────────────────────────────────────────
FAISS_INDEX_PATH=instance/faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── App Settings ───────────────────────────────────────────────────────────
MAX_CHAT_HISTORY=20
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
